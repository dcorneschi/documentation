source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm", "~> 1.1"

group :jekyll_plugins do
  gem "jekyll-optional-front-matter", "~> 0.3"   # articles have no front matter
  gem "jekyll-titles-from-headings", "~> 0.6"    # page title = first "# " heading
  gem "jekyll-relative-links", "~> 0.9"          # [..](../x/index.md) -> ../x/
  gem "jekyll-readme-index", "~> 0.6"            # README.md is the home page
  gem "jekyll-seo-tag", "~> 2.9"
  gem "jekyll-sitemap", "~> 1.4"
end

# Default gems that newer Rubies no longer bundle
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
